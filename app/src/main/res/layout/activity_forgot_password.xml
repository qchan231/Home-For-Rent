<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F5FE"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Header -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_house"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.08"
            android:text="QUẢN LÝ NHÀ TRỌ"
            android:textColor="#1D61E7"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo" />

        <!-- Card Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvAppName">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Indicator Thanh tiến trình 3 bước -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/stepBar1"
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_step_active" />

                    <View
                        android:id="@+id/stepBar2"
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_step_inactive" />

                    <View
                        android:id="@+id/stepBar3"
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_step_inactive" />
                </LinearLayout>

                <!-- ViewFlipper chứa 3 bước -->
                <ViewFlipper
                    android:id="@+id/viewFlipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- BƯỚC 1: NHẬP EMAIL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="BƯỚC 1 / 3"
                            android:textColor="#1D61E7"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Quên Mật Khẩu"
                            android:textColor="#0F172A"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Nhập email đã đăng ký để khôi phục mật khẩu"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_login_input"
                            android:drawableStart="@drawable/ic_email"
                            android:drawablePadding="12dp"
                            android:hint="example@gmail.com"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="16dp"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="15sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnStep1Next"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_login_button"
                            android:text="Tiếp tục  ➔"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- BƯỚC 2: NHẬP OTP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="BƯỚC 2 / 3"
                            android:textColor="#1D61E7"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Kiểm Tra Email"
                            android:textColor="#0F172A"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Nhập mã OTP để xác minh tài khoản của bạn"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTargetEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Mã gồm 6 chữ số đã được gửi tới minhquan@gmail.com"
                            android:textColor="#475569"
                            android:textSize="13sp" />

                        <!-- 6 Ô OTP -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/otp1"
                                android:layout_width="44dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_login_input"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="#0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/otp2"
                                android:layout_width="44dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_login_input"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="#0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/otp3"
                                android:layout_width="44dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_login_input"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="#0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/otp4"
                                android:layout_width="44dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_login_input"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="#0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/otp5"
                                android:layout_width="44dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_login_input"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="#0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/otp6"
                                android:layout_width="44dp"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_login_input"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textColor="#0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bạn chưa nhận được OTP? "
                                android:textColor="#64748B"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/btnResendOtp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gửi lại ngay"
                                android:textColor="#1D61E7"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnStep2Next"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_login_button"
                            android:text="Xác thực  ➔"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- BƯỚC 3: ĐỔI MẬT KHẨU -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="BƯỚC 3 / 3"
                            android:textColor="#1D61E7"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tạo Mật Khẩu Mới"
                            android:textColor="#0F172A"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Thiết lập mật khẩu mới an toàn và dễ ghi nhớ"
                            android:textColor="#64748B"
                            android:textSize="14sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp">

                            <EditText
                                android:id="@+id/etNewPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_login_input"
                                android:drawableStart="@drawable/ic_lock"
                                android:drawablePadding="12dp"
                                android:hint="Mật khẩu mới"
                                android:inputType="textPassword"
                                android:paddingStart="16dp"
                                android:paddingEnd="48dp"
                                android:textColor="#0F172A"
                                android:textColorHint="#94A3B8"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/btnTogglePass1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/ic_eye" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp">

                            <EditText
                                android:id="@+id/etConfirmPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_login_input"
                                android:drawableStart="@drawable/ic_lock"
                                android:drawablePadding="12dp"
                                android:hint="Xác nhận mật khẩu"
                                android:inputType="textPassword"
                                android:paddingStart="16dp"
                                android:paddingEnd="48dp"
                                android:textColor="#0F172A"
                                android:textColorHint="#94A3B8"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/btnTogglePass2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/ic_eye" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Sử dụng ít nhất 6 ký tự để bảo vệ tài khoản."
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnStep3Submit"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_login_button"
                            android:text="Xác nhận  ➔"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </ViewFlipper>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bạn cần hỗ trợ? Liên hệ chúng tôi"
            android:textColor="#64748B"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>