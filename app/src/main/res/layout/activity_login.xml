<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        android:paddingBottom="25dp">

        <!-- LOGO -->

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_house"
            android:contentDescription="Logo nhà trọ"
            android:scaleType="fitCenter"/>

        <!-- APP NAME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="QUẢN LÝ NHÀ TRỌ"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Kết nối dễ dàng,\nQuản lý hiệu quả"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:gravity="center"/>

        <!-- LOGIN CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="22dp"
            android:orientation="vertical"
            android:background="@drawable/bg_login_card"
            android:elevation="8dp">

            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng Nhập"
                android:textColor="@color/text_dark"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Vui lòng đăng nhập để tiếp tục"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:gravity="center"/>

            <!-- EMAIL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_login_input">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_email"
                    android:contentDescription="Email"/>

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="Email"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:background="@android:color/transparent"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:autofillHints="emailAddress"
                    android:padding="0dp"/>

            </LinearLayout>

            <!-- PASSWORD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="17dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_login_input">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Mật khẩu"/>

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="Mật khẩu"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:background="@android:color/transparent"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:autofillHints="password"
                    android:padding="0dp"/>

                <ImageView
                    android:id="@+id/btnShowPassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye"
                    android:contentDescription="Hiện mật khẩu"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- REMEMBER + FORGOT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/cbRemember"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ghi nhớ tôi"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    android:buttonTint="@color/primary"
                    android:padding="0dp"/>

                <TextView
                    android:id="@+id/btnForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quên mật khẩu?"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- LOGIN BUTTON -->

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="➜   Đăng nhập"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_login_button"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- REGISTER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn chưa có tài khoản?"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Đăng ký ngay  ›"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>