<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F5FE"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Quay lại"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_house"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Thẻ đổi mật khẩu -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">



                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Đổi Mật Khẩu"
                    android:textColor="#0F172A"
                    android:textSize="24sp"
                    android:textStyle="bold" />


                <!-- Mật khẩu hiện tại -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:labelFor="@id/etCurrentPassword"
                    android:text="Mật khẩu hiện tại"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etCurrentPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_login_input"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:hint="Nhập mật khẩu hiện tại"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@id/etNewPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="56dp"
                        android:saveEnabled="false"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnToggleCurrentPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="4dp"
                        android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="Hiện mật khẩu hiện tại"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <!-- Mật khẩu mới -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etNewPassword"
                    android:text="Mật khẩu mới"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_login_input"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:hint="Nhập mật khẩu mới"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@id/etConfirmPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="56dp"
                        android:saveEnabled="false"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnToggleNewPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="4dp"
                        android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="Hiện mật khẩu mới"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <!-- Xác nhận mật khẩu -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etConfirmPassword"
                    android:text="Xác nhận mật khẩu mới"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_login_input"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:hint="Nhập lại mật khẩu mới"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:paddingStart="16dp"
                        android:paddingEnd="56dp"
                        android:saveEnabled="false"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnToggleConfirmPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="4dp"
                        android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="Hiện xác nhận mật khẩu mới"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mật khẩu mới có ít nhất 6 ký tự và khác mật khẩu hiện tại."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_login_button"
                    android:text="Đổi mật khẩu"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>